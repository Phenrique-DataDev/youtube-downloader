node_modules/
dist/
build/
*.log

# Binarios de dependencia nunca sao versionados — o bootstrap os baixa e
# verifica hash. Ver DESIGN, secao Security.
*.exe
!scripts/**/*.exe
.cache/
.claude/.cache/

# Pacote do ffmpeg baixado para republicar como asset da Release. 167 MB —
# nunca versionado; a fonte de verdade e o asset da Release + o SHA256 pinado
# em src/bootstrap/ffmpeg.ts.
ffmpeg-*.zip

# Artefatos de teste
tests/.tmp/
coverage/

# UI embutida, regenerada a cada build/typecheck/teste a partir de src/ui/.
# Versionar geraria divergencia silenciosa com os arquivos-fonte.
src/ui/ativos.gerado.ts
